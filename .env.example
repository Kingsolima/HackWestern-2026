# Copy to .env and fill in. Never commit .env, and never paste these values into an
# agent prompt: Entire pushes session transcripts with the code.

# --- Backend orchestrator ---
CORS_ORIGINS=http://localhost:5173
CAD_WORKER_URL=http://localhost:8001

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- TinyFish ---
TINYFISH_API_KEY=
# live = call TinyFish and record fixtures; replay = use data/fixtures, no network
TF_MODE=replay

# --- Tiger Data (Postgres + TimescaleDB) ---
# Local docker compose default; swap for the Tiger Cloud URL in deployment.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/redesign

# --- Vultr Object Storage (S3-compatible) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Auth0 ---
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
