# Copy to .env and fill in. Never commit .env, and never paste these values into an
# agent prompt: Entire pushes session transcripts with the code.

# --- Backend orchestrator ---
CORS_ORIGINS=http://localhost:5173
CAD_WORKER_URL=http://localhost:8001

# --- Gemini ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-pro

# --- TinyFish ---
TINYFISH_API_KEY=
# Where record/replay stores calls. Must be writable for live jobs (docker compose sets
# /recordings, bound to ./data/recordings). Default: data/recordings.
# RECORDINGS_DIR=

# --- Public deploy (docs/DEPLOY.md) ---
# Live jobs need X-Live-Token when REQUIRE_LIVE_TOKEN=true (set by docker-compose.prod.yml).
LIVE_JOBS_TOKEN=
# Caddy site address: ":80" on the server IP, or "example.com, www.example.com" for HTTPS.
# SITE_ADDRESS=

# --- Tiger Data (Postgres + TimescaleDB) ---
# Local docker compose default; swap for the Tiger Cloud URL in deployment.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/redesign

# --- Vultr Object Storage (S3-compatible) ---
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# --- Auth0 ---
AUTH0_DOMAIN=
AUTH0_AUDIENCE=
